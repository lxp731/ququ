# QuQu 后端环境变量
# 复制此文件为 .env 后根据需要修改

# ── 模型缓存 ──
# 模型文件存放根目录（ModelScope snapshot_download 的 cache_dir）
# 源码运行默认:
#   Linux   ~/.cache/modelscope
#   Windows C:\Users\<用户名>\.cache\modelscope
# Docker 默认 /models
MODELSCOPE_CACHE=

# ── 运行时 ──
# gunicorn worker 进程数（每个 worker 独占一套模型，约 3GB 内存；设为 1 即串行转写）
FUNASR_WORKERS=1
# PyTorch 推理时，使用 CPU 并行核心数
OMP_NUM_THREADS=4
# gunicorn 线程数（用于排队等待，不影响并发转写能力）
FUNASR_THREADS=8

# 上传音频临时文件目录（默认系统临时目录 /tmp）
QUQU_TMP_DIR=

# ── 服务 ──
# 监听端口/地址（仅 python server.py 源码运行时有效，容器通过 docker-compose 映射端口）
FUNASR_HOST=0.0.0.0
FUNASR_PORT=8000
