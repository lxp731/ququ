# QuQu 后端环境变量
# 复制此文件为 .env 后根据需要修改

# ── 模型缓存 ──
# 模型文件存放根目录（ModelScope snapshot_download 的 cache_dir）
# 源码运行默认:
#   Linux   ~/.cache/modelscope
#   Windows C:\Users\<用户名>\.cache\modelscope
# Docker 默认 /models
# damo 子路径由程序自动探测（hub/damo 或直接 damo）
MODELSCOPE_CACHE=

# ── 运行时 ──
# PyTorch 并行线程数
OMP_NUM_THREADS=4

# 上传音频临时文件目录（默认系统临时目录 /tmp）
QUQU_TMP_DIR=

# ── 服务 ──
# 监听端口（仅 python funasr_server.py 直接运行时有效，gunicorn 见 entrypoint.sh）
FUNASR_HOST=0.0.0.0
FUNASR_PORT=8000
