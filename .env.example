# QuQu 后端环境变量
# 复制此文件为 .env 后根据需要修改

# ── 模型缓存 ──
# 模型文件存放根目录（ModelScope snapshot_download 的 cache_dir）
# 源码运行默认:
#   Linux   ~/.cache/modelscope
#   Windows C:\Users\<用户名>\.cache\modelscope
# Docker 默认 /models
MODELSCOPE_CACHE=

# ── 运行时 ──
# 当前后端为 FastAPI + uvicorn 单进程 (REST + WebSocket 同端口)
# PyTorch 推理时，使用 CPU 并行核心数
OMP_NUM_THREADS=4

# 上传音频临时文件目录（默认系统临时目录 /tmp）
QUQU_TMP_DIR=

# ── 安全 (可选) ──
# CORS 允许的来源 (逗号分隔, 默认仅本机开发/打包来源)
# QUQU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,file://
# 音频缓冲水位上限 (字节, 默认 20MB ≈ 10 分钟)
# QUQU_MAX_AUDIO_BUFFER=20971520
# HTTP 上传大小上限 (字节, 默认 100MB)
# QUQU_MAX_UPLOAD=104857600

# ── 服务 ──
# 监听端口/地址（仅 python server.py 源码运行时有效，容器通过 docker-compose 映射端口）
FUNASR_HOST=0.0.0.0
FUNASR_PORT=8000
